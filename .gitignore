# Except README.md
!README.md

# Keep repository instructions tracked despite the catch-all rule.
!AGENTS.md

# Except .gitignore (so it stays tracked)
!.gitignore

# Ignore environment files
.env
.env.local
.env.development
.env.production
.env.*.local

# Ignore node_modules
node_modules/

# Ignore logs
*.log
npm-debug.log*

# Ignore build output
build/
dist/

# Ignore IDE
.vscode/
.idea/

# Ignore OS
.DS_Store
Thumbs.db
